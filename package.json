{
	"name": "toolz",
	"version": "3.2.0",
	"private": true,
	"description": "A set of accessible web tools",
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "webpack serve --config config/webpack.dev.js",
		"build": "webpack --config config/webpack.prod.js",
		"build-list": "node src/script/build_list.mjs",
		"check-hosts": "node src/script/check_hosts.mjs",
		"purge": "node config/purgecss.mjs",
		"format": "prettier --write '**/*.{js,mjs,ts}' src/data/adblock_data.json",
		"lint": "eslint 'src/**/*.{js,mjs}' 'config/**/*.{js,mjs}' && echo 'Linting complete!'",
		"lint-fix": "eslint 'src/**/*.{js,mjs}' 'config/**/*.{js,mjs}' --fix"
	},
	"author": "Eduard Ursu",
	"license": "(CC BY-NC-SA 4.0)",
	"bugs": {
		"url": "https://github.com/d3ward/toolz/issues"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"copy-webpack-plugin": "^14.0.0",
		"css-loader": "^7.1.5",
		"ejs": "^7.0.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^17.14.0",
		"html-loader": "^5.1.0",
		"html-webpack-plugin": "^5.6.8",
		"mini-css-extract-plugin": "^2.10.2",
		"prettier": "^3.10.1",
		"purgecss": "^9.1.0",
		"sass": "^1.108.2",
		"sass-loader": "^17.1.0",
		"template-ejs-loader": "^0.9.4",
		"terser-webpack-plugin": "^5.6.1",
		"webpack": "^5.113.0",
		"webpack-cli": "^7.3.1",
		"webpack-dev-server": "^6.1.0",
		"webpack-merge": "^6.0.1"
	}
}
